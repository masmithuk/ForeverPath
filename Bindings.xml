<!--
    Key bindings for the Target button (cycles through every creature) and
    the extra per-creature buttons (2nd to 6th creature). It appears under
    Options > Keybindings > AddOns > ForeverPath. The binding "clicks" the
    secure button, which is what lets it change your target.
-->
<Bindings>
    <Binding name="CLICK ForeverPathTargetButton:LeftButton" header="FOREVERPATH" category="ADDONS">
    </Binding>
    <Binding name="CLICK ForeverPathTargetButton2:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK ForeverPathTargetButton3:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK ForeverPathTargetButton4:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK ForeverPathTargetButton5:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK ForeverPathTargetButton6:LeftButton" category="ADDONS">
    </Binding>
</Bindings>
