<!--
    Key bindings for the Target button (cycles through every creature) and
    the extra per-creature buttons (2nd to 6th creature). It appears under
    Options > Keybindings > AddOns > Questwalker. The binding "clicks" the
    secure button, which is what lets it change your target.
-->
<Bindings>
    <Binding name="CLICK QuestwalkerTargetButton:LeftButton" header="QUESTWALKER" category="ADDONS">
    </Binding>
    <Binding name="CLICK QuestwalkerTargetButton2:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK QuestwalkerTargetButton3:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK QuestwalkerTargetButton4:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK QuestwalkerTargetButton5:LeftButton" category="ADDONS">
    </Binding>
    <Binding name="CLICK QuestwalkerTargetButton6:LeftButton" category="ADDONS">
    </Binding>
</Bindings>
